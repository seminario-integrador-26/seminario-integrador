# Plantilla de .env para PRODUCCIÓN (VPS + Docker).
# Copiala a ".env" en el server y completá los valores marcados.
# NO se incluye en la imagen: el .env real vive solo en el VPS.

APP_NAME="Seminario Integrador"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # generar con: docker compose ... exec app php artisan key:generate --show
APP_URL=https://TU-DOMINIO     # ej. https://seminario.tudominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# --- Base de datos (Postgres dentro de Docker) ---
# DB_HOST DEBE ser "db": es el nombre del servicio en docker-compose.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=seminario_integrador
DB_USERNAME=seminario
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_FUERTE

# --- Sesión / cache / colas (todo en la DB, sin Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true     # cookies solo por HTTPS
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Logs ---
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- WhatsApp Cloud API (Meta) — completar cuando se integre el módulo ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# --- Mail (recuperación de contraseña) — completar con tu proveedor ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@TU-DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
